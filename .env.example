PORT=3000
NODE_ENV=development

# Comma-separated origins, or * to reflect the request origin (dev only).
CORS_ORIGINS=http://localhost:3000

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=chat_user
DATABASE_PASSWORD=chat_password
DATABASE_NAME=realtime_chat
DATABASE_URL="postgresql://chat_user:chat_password@localhost:5432/realtime_chat?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379